        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"unregistered-account@st.ueh.edu.vn\",\n  \"password\": \"{{VAR_TEST_PASS}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Kiểm tra bảo mật: không tiết lộ sự tồn tại của email."
      },
      "response": []
    },
    {
      "name": "7. Kiểm tra Token - Truy cập Protected Endpoint có Bearer Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/teams",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "teams"
          ]
        },
        "description": "Gửi Bearer Token trong Header để gọi API được bảo vệ."
      },
      "response": []
    },
    {
      "name": "8. Kiểm tra Token - Không có Bearer Token (401 Unauthorized)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 401 Unauthorized\", function () {",
              "    pm.response.to.have.status(401);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/teams",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "teams"
          ]
        },
        "description": "Không truyền token vào endpoint bảo vệ, kỳ vọng bị chặn 401."
      },
      "response": []
    },
    {
      "name": "9. Đăng xuất (Logout)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Đăng xuất thành công\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.message).to.eql(\"Logout successful\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
