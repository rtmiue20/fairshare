{
  "info": {
    "_postman_id": "f48b1234-9876-4321-b123-fairshareauth01",
    "name": "FairShare - Auth & JWT API (M3 - Ngô Trọng Phúc)",
    "description": "Bộ Postman Collection phục vụ kiểm thử và làm minh chứng cho Phân hệ Xác thực & Phân quyền (Auth & JWT) - Sprint 3 (M3: Ngô Trọng Phúc - Backend 1).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "VAR_TEST_PASS",
      "value": "",
      "type": "string"
    },
    {
      "key": "VAR_WRONG_PASS",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Đăng ký (Register) - Thành công",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Trả về access token và thông tin user\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.accessToken).to.not.be.empty;",
              "    pm.expect(jsonData.data.tokenType).to.eql(\"Bearer\");",
              "    pm.expect(jsonData.data.user.email).to.eql(\"ngotrongphuc@st.ueh.edu.vn\");",
              "    pm.collectionVariables.set(\"accessToken\", jsonData.data.accessToken);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ngotrongphuc@st.ueh.edu.vn\",\n  \"password\": \"{{VAR_TEST_PASS}}\",\n  \"fullName\": \"Ngô Trọng Phúc\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "description": "Đăng ký tài khoản sinh viên mới thành công, nhận về JWT token và thông tin user."
      },
      "response": []
    },
    {
      "name": "2. Đăng ký (Register) - Trùng Email (409 Conflict)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 409 Conflict\", function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "pm.test(\"Trả về thông báo lỗi trùng email\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(false);",
              "    pm.expect(jsonData.message).to.include(\"already registered\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ngotrongphuc@st.ueh.edu.vn\",\n  \"password\": \"{{VAR_TEST_PASS}}\",\n  \"fullName\": \"Ngô Trọng Phúc\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "description": "Đăng ký với email đã tồn tại trong hệ thống, kỳ vọng trả về mã 409."
      },
      "response": []
    },
    {
      "name": "3. Đăng ký (Register) - Thiếu trường bắt buộc (400 Bad Request)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Validation error chi tiết\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(false);",
              "    pm.expect(jsonData.message).to.eql(\"Validation failed\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"khong-hop-le\",\n  \"password\": \"\",\n  \"fullName\": \"\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "description": "Kiểm tra cơ chế Validation của Spring Security & Bean Validation."
      },
      "response": []
    },
    {
      "name": "4. Đăng nhập (Login) - Thành công",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Lưu access token\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.accessToken).to.not.be.empty;",
              "    pm.collectionVariables.set(\"accessToken\", jsonData.data.accessToken);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ngotrongphuc@st.ueh.edu.vn\",\n  \"password\": \"{{VAR_TEST_PASS}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Đăng nhập với email và mật khẩu đúng, hệ thống trả về Bearer Token."
      },
      "response": []
    },
    {
      "name": "5. Đăng nhập (Login) - Sai mật khẩu (401 Unauthorized)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 401 Unauthorized\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test(\"Thông báo lỗi đăng nhập chung\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(false);",
              "    pm.expect(jsonData.message).to.eql(\"Invalid email or password\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ngotrongphuc@st.ueh.edu.vn\",\n  \"password\": \"{{VAR_WRONG_PASS}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Đăng nhập sai mật khẩu."
      },
      "response": []
    },
    {
      "name": "6. Đăng nhập (Login) - Email không tồn tại (401 Unauthorized)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 401 Unauthorized\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test(\"Bảo mật: không tiết lộ email có tồn tại hay không\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(false);",
              "    pm.expect(jsonData.message).to.eql(\"Invalid email or password\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
