# Biến môi trường cho STAGING. Copy thành .env.staging rồi điền giá trị:
#   cp .env.staging.example .env.staging
# Hoặc để script tự sinh mật khẩu ngẫu nhiên: ./scripts/staging-up.sh
# KHÔNG commit .env.staging lên Git (đã có trong .gitignore).

# --- MariaDB ---
DB_NAME=fairshare
DB_USER=fairshare
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Backend ---
# Chuỗi ngẫu nhiên >= 32 byte, ví dụ: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- Cổng xuất ra máy host (staging) ---
BACKEND_PORT=8080
FRONTEND_PORT=8081
