# Copy thành .env rồi ĐIỀN mật khẩu (bắt buộc):  cp .env.example .env
# KHÔNG commit file .env lên Git.

# --- MariaDB (docker compose) ---
DB_NAME=fairshare
DB_USER=fairshare
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_PORT=3306

# --- Backend: khóa ký token đăng nhập (bắt buộc, >= 32 byte) ---
# Sinh ngẫu nhiên:  openssl rand -hex 32      (Windows: py -c "import secrets;print(secrets.token_hex(32))")
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- Cổng xuất ra máy host ---
BACKEND_PORT=8080
FRONTEND_PORT=80
